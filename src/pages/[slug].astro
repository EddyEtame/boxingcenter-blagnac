---
import Link from '../components/Link.astro';
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import Arrow from '../components/Arrow.astro';
import FAQ from '../components/FAQ.astro';
import Sources from '../components/Sources.astro';
import SessionCard from '../components/SessionCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { pages } from '../data/pages.mjs';
import { CLUB, disciplines } from '../data/site.mjs';
export function getStaticPaths() { return pages.map(page => ({ params: { slug: page.slug }, props: { page } })); }
const { page } = Astro.props;
const practical = ['plannings','tarifs','contact'].includes(page.slug);
const discipline = disciplines.find(d => d.slug === page.slug);
// Le fil d'Ariane reprend la première partie du titre ; la ligne sous le H1 situe le club.
const crumb = page.title.split(' — ')[0].split(' | ')[0];
const context = page.context;
const mma = page.slug === 'mma-blagnac';
const contact = page.slug === 'contact';
---
<Base page={page}>
  <nav class="breadcrumbs" aria-label="Fil d’Ariane"><Link href="/">Boxe près de Blagnac</Link><span aria-hidden="true">/</span><span aria-current="page">{crumb}</span></nav>
  {practical ? <section class="practical-hero" aria-labelledby="page-title"><div><p class="eyebrow">{page.eyebrow.toUpperCase()}</p><h1 id="page-title">{page.headline.map(line => <span>{line}</span>)}<small class="h1-context">{context}</small></h1><p class="practical-hero-intro">{page.intro}</p><Link class="text-link practical-direct" href={page.ctaUrl}>{page.ctaLabel}<Arrow diagonal={!page.ctaUrl.startsWith('/')} /></Link>{contact && <div class="contact-details" data-prompt-clear><Link href={CLUB.phoneHref}>{CLUB.phone} <Arrow diagonal /></Link><Link href={CLUB.directions}>Préparer mon trajet <Arrow diagonal /></Link></div>}</div><aside class="official-card"><p class="eyebrow">BOXING CENTER · TOULOUSE MINIMES</p><span class="big-arrow" aria-hidden="true">↗</span><h2>{page.slug==='plannings' ? 'Planning officiel.' : page.slug==='tarifs' ? 'Tarifs officiels.' : 'On en parle ?'}</h2><p>{contact ? CLUB.address : 'Retrouve les informations de la saison directement sur le site du club.'}</p><Link href={contact ? CLUB.contact : page.ctaUrl} class="button button-dark">{contact ? 'Le contact du club' : page.ctaLabel}<Arrow diagonal /></Link></aside></section> : <section class="page-hero" aria-labelledby="page-title"><div><p class="eyebrow">{page.eyebrow.toUpperCase()}</p><h1 id="page-title">{page.headline.map(line => <span>{line}</span>)}<small class="h1-context">{context}</small></h1><p class="page-hero-intro">{page.intro}</p><Link class="button button-dark" href={page.ctaUrl}>{page.ctaLabel}<Arrow diagonal={!page.ctaUrl.startsWith('/')} /></Link>{page.secondary && <Link class="text-link secondary-link" href={page.secondary.url}>{page.secondary.label}<Arrow diagonal={!page.secondary.url.startsWith('/')} /></Link>}</div><Picture name={page.image} eager sizes="(max-width: 600px) 100vw, 45vw" /></section>}
  {contact && <ContactForm />}
  {!practical && <><dl class="page-facts">{page.facts.map(fact => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl>
  <section class="editorial" aria-label={crumb}><div class="editorial-index"><p class="eyebrow">{crumb.toUpperCase()}<br /><br />LES BONS REPÈRES</p></div><div>{page.sections.map((section,i) => <article class="editorial-block"><span>0{i+1}</span><div><h2>{section.title}</h2><p>{section.text}</p></div></article>)}</div></section>
  {discipline && <SessionCard initial={discipline.id} />}</>}
  <FAQ items={page.faqs} label={mma ? 'Ton projet MMA, en clair.' : 'Tes questions. Tes repères.'} />
  <Sources urls={page.sources} />
  {!practical && <><section class="page-action"><div><h2>De l’envie au premier geste.</h2><p>{mma ? 'Cage, grappling, JJB et boxe au même endroit : réserve une séance d’essai au club MMA Boxing Center, ou pose ta question à l’équipe des Minimes.' : `Les plannings, les tarifs et la réservation de la première séance à ${CLUB.trialPrice} t’attendent sur le site des Minimes.`}</p></div><div class="page-action-links"><Link class="button button-dark" href={page.ctaUrl}>{page.ctaLabel}<Arrow diagonal={!page.ctaUrl.startsWith('/')} /></Link>{page.secondary && <Link class="text-link" href={page.secondary.url}>{page.secondary.label}<Arrow diagonal={!page.secondary.url.startsWith('/')} /></Link>}</div></section>
  <section class="related section-pad"><p class="eyebrow">POUR CONTINUER TON CHOIX</p><nav aria-label="Pages complémentaires">{page.related.map(slug => { const target=pages.find(p=>p.slug===slug); return target && <Link href={`/${slug}/`}>{target.title.split(' — ')[0].split(' | ')[0]}<Arrow /></Link>; })}</nav></section></>}
  {practical && <section class="practical-connections"><p class="eyebrow">PRÉPARER TA VENUE AUX MINIMES</p><nav aria-label="Informations du club"><Link href={CLUB.planning}>Voir les plannings <Arrow diagonal /></Link><Link href={CLUB.prices}>Voir les tarifs <Arrow diagonal /></Link><Link href={CLUB.trial}>Réserver une séance d’essai · {CLUB.trialPrice} <Arrow diagonal /></Link><Link href={CLUB.contact}>Contact & accès <Arrow diagonal /></Link></nav></section>}
</Base>
