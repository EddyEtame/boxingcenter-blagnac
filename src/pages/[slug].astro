---
import Link from '../components/Link.astro';
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import Arrow from '../components/Arrow.astro';
import FAQ from '../components/FAQ.astro';
import Sources from '../components/Sources.astro';
import SessionCard from '../components/SessionCard.astro';
import { pages } from '../data/pages.mjs';
import { CLUB, disciplines } from '../data/site.mjs';
export function getStaticPaths() { return pages.map(page => ({ params: { slug: page.slug }, props: { page } })); }
const { page } = Astro.props;
const practical = ['plannings','tarifs','contact'].includes(page.slug);
const discipline = disciplines.find(d => d.slug === page.slug);
const context = page.title.split(' — ')[0];
const headline = page.slug === 'plannings' ? ['Les plannings.', 'Aux Minimes.'] : page.slug === 'tarifs' ? ['Les tarifs.', 'Aux Minimes.'] : page.headline;
---
<Base page={page}>
  <nav class="breadcrumbs" aria-label="Fil d’Ariane"><Link href="/">Boxe près de Blagnac</Link><span aria-hidden="true">/</span><span aria-current="page">{context}</span></nav>
  {practical ? <section class="practical-hero" aria-labelledby="page-title"><div><p class="eyebrow">{page.eyebrow.toUpperCase()}</p><h1 id="page-title">{headline.map(line => <span>{line}</span>)}<small class="h1-context">{context}</small></h1><p class="practical-hero-intro">{page.intro}</p><Link class="text-link practical-direct" href={page.ctaUrl}>{page.ctaLabel}<Arrow diagonal /></Link>{page.slug === 'contact' && <div class="contact-details"><Link href={CLUB.phoneHref}>{CLUB.phone} <Arrow diagonal /></Link><Link href={CLUB.directions}>Préparer mon trajet <Arrow diagonal /></Link></div>}</div><aside class="official-card"><p class="eyebrow">BOXING CENTER · TOULOUSE MINIMES</p><span class="big-arrow" aria-hidden="true">↗</span><h2>{page.slug==='plannings' ? 'Planning officiel.' : page.slug==='tarifs' ? 'Tarifs officiels.' : 'On en parle ?'}</h2><p>{page.slug==='contact' ? CLUB.address : 'Retrouvez les informations actuelles directement sur le site du club.'}</p><Link href={page.ctaUrl} class="button button-dark">{page.ctaLabel}<Arrow diagonal /></Link></aside></section> : <section class="page-hero" aria-labelledby="page-title"><div><p class="eyebrow">{page.eyebrow.toUpperCase()}</p><h1 id="page-title">{headline.map(line => <span>{line}</span>)}<small class="h1-context">{context}</small></h1><p class="page-hero-intro">{page.intro}</p><Link class="button button-dark" href={page.ctaUrl}>{page.ctaLabel}<Arrow diagonal /></Link></div><Picture name={page.image} eager sizes="(max-width: 600px) 100vw, 45vw" /></section>}
  {!practical && <><dl class="page-facts">{page.facts.map(fact => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl>
  <section class="editorial" aria-label={context}><div class="editorial-index"><p class="eyebrow">{context.toUpperCase()}<br /><br />LES BONS REPÈRES</p></div><div>{page.sections.map((section,i) => <article class="editorial-block"><span>0{i+1}</span><div><h2>{section.title}</h2><p>{section.text}</p></div></article>)}</div></section>
  {discipline && <SessionCard initial={discipline.id} />}</>}
  <FAQ items={page.faqs} label={page.slug==='mma-blagnac' ? 'Votre projet MMA, en clair.' : 'Vos questions. Vos repères.'} />
  <Sources urls={page.sources} />
  {!practical && <><section class="page-action"><div><h2>De l’envie au premier geste.</h2><p>{page.slug==='mma-blagnac' ? 'Votre niveau, votre envie, vos disponibilités : échangez avec l’équipe pour choisir votre cours.' : 'Les plannings, les tarifs et les conditions de première séance vous attendent sur le site des Minimes.'}</p></div><Link class="button button-dark" href={page.ctaUrl}>{page.ctaLabel}<Arrow diagonal /></Link></section>
  <section class="related section-pad"><p class="eyebrow">POUR CONTINUER VOTRE CHOIX</p><nav aria-label="Pages complémentaires">{page.related.map(slug => { const target=pages.find(p=>p.slug===slug); return target && <Link href={`/${slug}/`}>{target.title.split(' — ')[0]}<Arrow diagonal /></Link>; })}</nav></section></>}
  {practical && <section class="practical-connections"><p class="eyebrow">PRÉPARER VOTRE VENUE AUX MINIMES</p><nav aria-label="Informations du club"><Link href={CLUB.planning}>Voir les plannings <Arrow diagonal /></Link><Link href={CLUB.prices}>Voir les tarifs <Arrow diagonal /></Link><Link href={CLUB.trial}>Préparer mon essai <Arrow diagonal /></Link><Link href={CLUB.contact}>Contact & accès <Arrow diagonal /></Link></nav></section>}
</Base>
