---
import Link from '../components/Link.astro';
import '../styles/global.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource-variable/manrope';
import Arrow from '../components/Arrow.astro';
import Brand from '../components/Brand.astro';
import ClubPrompt from '../components/ClubPrompt.astro';
import { SITE, CLUB, disciplines } from '../data/site.mjs';
const { page, noindex = false } = Astro.props;
const path = page.slug ? `/${page.slug}/` : '/';
const canonical = `${SITE}${path}`;
const social = `${SITE}/social/${page.slug || 'accueil'}.png`;
const socialAlt = `${page.title} — photographie du réseau et logo officiel Boxing Center ; destination Toulouse Minimes.`;
const destination = `${SITE}/#destination-toulouse-minimes`;
const schema = [
  { '@type': 'Place', '@id': destination, name: CLUB.name, url: CLUB.url, address: CLUB.postalAddress, hasMap: CLUB.directions },
  { '@type': 'WebSite', '@id': `${SITE}/#website`, url: `${SITE}/`, name: 'Boxing Center — depuis Blagnac', inLanguage: 'fr-FR', about: { '@id': destination }, audience: { '@type': 'Audience', geographicArea: { '@type': 'City', name: 'Blagnac' } } },
  { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: page.title, description: page.description, inLanguage: 'fr-FR', isPartOf: { '@id': `${SITE}/#website` }, about: { '@id': destination }, primaryImageOfPage: { '@type': 'ImageObject', url: social, width: 1200, height: 630, caption: socialAlt } },
  ...(page.slug ? [{ '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Boxe près de Blagnac', item: `${SITE}/` }, { '@type': 'ListItem', position: 2, name: page.title.split(' — ')[0], item: canonical }] }] : []),
  ...(page.faqs?.length ? [{ '@type': 'FAQPage', '@id': `${canonical}#faq`, mainEntity: page.faqs.map((q) => ({ '@type': 'Question', name: q.question, acceptedAnswer: { '@type': 'Answer', text: q.answer } })) }] : [])
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title}</title><meta name="description" content={page.description} /><meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} /><link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#6ee3c8" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" /><meta property="og:locale" content="fr_FR" /><meta property="og:site_name" content="Boxing Center — depuis Blagnac" /><meta property="og:title" content={page.title} /><meta property="og:description" content={page.description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={social} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={socialAlt} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={page.title} /><meta name="twitter:description" content={page.description} /><meta name="twitter:image" content={social} /><meta name="twitter:image:alt" content={socialAlt} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': schema }).replace(/</g, '\u003c')} />}
  </head>
  <body>
    <Link class="skip-link" href="#contenu">Aller au contenu</Link>
    <header class="site-header"><Brand /><nav class="desktop-nav" aria-label="Navigation principale"><Link href={CLUB.activities}>Les pratiques</Link><Link href={`${CLUB.url}le-club/`} aria-current={page.slug === 'club-boxe-blagnac' ? 'page' : undefined}>Le club</Link><Link href={CLUB.planning} aria-current={page.slug === 'plannings' ? 'page' : undefined}>Plannings</Link><Link href={CLUB.prices} aria-current={page.slug === 'tarifs' ? 'page' : undefined}>Tarifs</Link><Link href={CLUB.contact} aria-current={page.slug === 'contact' ? 'page' : undefined}>Contact</Link></nav><Link class="header-cta" href={CLUB.trial}><span>Préparer mon essai<small>TOULOUSE MINIMES</small></span><Arrow diagonal /></Link><Link class="mobile-club-cta" href={CLUB.url} aria-label="Le club Toulouse Minimes — site officiel, nouvel onglet"><span>Le club<small>MINIMES</small></span><Arrow diagonal /></Link><details class="mobile-menu"><summary aria-controls="mobile-navigation">Menu <span aria-hidden="true">+</span></summary><nav id="mobile-navigation" aria-label="Navigation mobile"><Link href="/" aria-current={!page.slug ? 'page' : undefined}>Accueil</Link><Link href={CLUB.activities}>Les pratiques</Link><Link href={`${CLUB.url}le-club/`} aria-current={page.slug === 'club-boxe-blagnac' ? 'page' : undefined}>Le club proche de vous</Link><Link href={CLUB.planning} aria-current={page.slug === 'plannings' ? 'page' : undefined}>Plannings</Link><Link href={CLUB.prices} aria-current={page.slug === 'tarifs' ? 'page' : undefined}>Tarifs</Link><Link href={CLUB.contact} aria-current={page.slug === 'contact' ? 'page' : undefined}>Contact & accès</Link><Link class="menu-trial" href={CLUB.trial}>Préparer mon essai <Arrow diagonal /><small>AU CLUB DE TOULOUSE MINIMES</small></Link></nav></details></header>
    <div class="menu-backdrop" aria-hidden="true"></div>
    <main id="contenu"><slot /></main>
    <footer class="site-footer"><div class="footer-top"><p class="eyebrow">LE PROCHAIN MOUVEMENT VOUS APPARTIENT.</p><Link href={CLUB.trial} class="footer-invitation">ON SE<br /><em>RETROUVE ?</em><Arrow diagonal /></Link><div class="footer-location"><span class="route-dot"></span><p>VOUS, À BLAGNAC.<br />LE CLUB, À TOULOUSE MINIMES.</p><p>{CLUB.address}<br /><Link href={CLUB.contact}>Préparer votre venue ↗</Link></p></div></div><div class="footer-grid"><div><Brand footer /><p>La boxe proche de Blagnac.<br />Votre entraînement aux Minimes.</p></div><nav aria-label="Pratiques en pied de page">{disciplines.map(d => <Link href={`/${d.slug}/`}>{d.name} près de Blagnac</Link>)}</nav><nav aria-label="Informations pratiques"><Link href="/club-boxe-blagnac/">Le club & votre première visite</Link><Link href="/plannings/">Plannings</Link><Link href="/tarifs/">Tarifs</Link><Link href="/contact/">Contact & accès</Link><Link href="/confidentialite/">Confidentialité</Link></nav></div><div class="footer-bottom"><span>BOXING CENTER · DEPUIS BLAGNAC</span><Link href={CLUB.url}>Le site de Toulouse Minimes <Arrow diagonal /></Link><span>À VOTRE RYTHME.</span></div></footer>
    <ClubPrompt slug={page.slug} />
    <script>import '../scripts/site.ts';</script>
  </body>
</html>
