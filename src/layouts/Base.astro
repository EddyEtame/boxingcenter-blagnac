---
import Link from '../components/Link.astro';
import '../styles/global.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource-variable/manrope';
import Arrow from '../components/Arrow.astro';
import Brand from '../components/Brand.astro';
import ClubPrompt from '../components/ClubPrompt.astro';
import { SITE, CLUB, disciplines } from '../data/site.mjs';
import { canonicalOf, socialFor, developer, sourceNames } from '../data/seo.mjs';
import { lastModified } from '../lib/revisions.mjs';
import { blockRobots } from '../lib/environment.mjs';
const { page, noindex = false } = Astro.props;
const canonical = canonicalOf(page.slug);
const { url: social, alt: socialAlt } = socialFor(page);
const modified = lastModified(page.slug);
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const destination = CLUB.entityId;
// Un aperçu Vercel (*.vercel.app) ne doit jamais concurrencer le domaine réel : noindex figé au build.
const robots = noindex ? 'noindex, follow' : blockRobots ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
// La navigation reste sur ce site (décision d'Eddy, 4 octobre 2026) ; seul l'essai est externe.
const nav = [
  { href: '/club-boxe-blagnac/', label: 'Le club', slug: 'club-boxe-blagnac' },
  { href: '/#disciplines', label: 'Les pratiques', slug: null },
  { href: '/plannings/', label: 'Plannings', slug: 'plannings' },
  { href: '/tarifs/', label: 'Tarifs', slug: 'tarifs' },
  { href: '/contact/', label: 'Contact', slug: 'contact' },
];
const schema = [
  { '@type': 'Person', '@id': developer.id, name: developer.name, jobTitle: developer.role, url: developer.url, sameAs: developer.profiles, description: developer.contribution },
  { '@type': 'Place', '@id': destination, name: CLUB.name, url: CLUB.url, address: CLUB.postalAddress, telephone: CLUB.phone, hasMap: CLUB.directions },
  { '@type': 'WebSite', '@id': `${SITE}/#website`, url: `${SITE}/`, name: 'Boxing Center — depuis Blagnac', inLanguage: 'fr-FR', about: { '@id': destination }, creator: { '@id': developer.id }, audience: { '@type': 'Audience', geographicArea: { '@type': 'City', name: 'Blagnac' } } },
  { '@type': page.slug === 'contact' ? 'ContactPage' : 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: page.title, description: page.description, inLanguage: 'fr-FR', isPartOf: { '@id': `${SITE}/#website` }, about: { '@id': destination }, creator: { '@id': developer.id }, ...(modified ? {dateModified: modified} : {}), ...(page.slug ? {breadcrumb: {'@id': `${canonical}#breadcrumb`}} : {}), ...(page.faqs?.length ? {hasPart: {'@id': `${canonical}#faq`}} : {}), ...(page.sources?.length ? {citation: page.sources.map(url => ({'@type':'WebPage',url,name:sourceNames[url]}))} : {}), primaryImageOfPage: { '@type': 'ImageObject', url: social, width: 1200, height: 630, caption: socialAlt } },
  ...(page.slug ? [{ '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Boxe près de Blagnac', item: `${SITE}/` }, { '@type': 'ListItem', position: 2, name: page.title.split(' — ')[0].split(' | ')[0], item: canonical }] }] : []),
  ...(page.faqs?.length ? [{ '@type': 'FAQPage', '@id': `${canonical}#faq`, mainEntity: page.faqs.map((q, i) => ({ '@type': 'Question', '@id': `${canonical}#question-${i+1}`, name: q.question, acceptedAnswer: { '@type': 'Answer', '@id': `${canonical}#answer-${i+1}`, text: q.answer } })) }] : [])
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title}</title><meta name="description" content={page.description} /><meta name="robots" content={robots} /><link rel="canonical" href={canonical} />
    <meta name="author" content={developer.name} /><link rel="author" href="/humans.txt" type="text/plain" /><link rel="alternate" href="/llms.txt" type="text/plain" title="Guide textuel du site" /><link rel="sitemap" href="/sitemap.xml" type="application/xml" />
    {verification && <meta name="google-site-verification" content={verification} />}
    <meta name="theme-color" content="#0a1020" /><link rel="icon" href="/favicon.ico" sizes="48x48" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" /><link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" /><link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" /><meta property="og:locale" content="fr_FR" /><meta property="og:site_name" content="Boxing Center — depuis Blagnac" /><meta property="og:title" content={page.title} /><meta property="og:description" content={page.description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={social} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={socialAlt} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={page.title} /><meta name="twitter:description" content={page.description} /><meta name="twitter:image" content={social} /><meta name="twitter:image:alt" content={socialAlt} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': schema }).replace(/</g, '<')} />}
    <script is:inline>try{if(localStorage.getItem('bc-theme')==='blagnac'){document.documentElement.dataset.theme='blagnac';document.querySelector('meta[name="theme-color"]').content='#192724'}}catch(e){}</script>
  </head>
  <body>
    <Link class="skip-link" href="#contenu">Aller au contenu</Link>
    <header class="site-header"><Brand /><nav class="desktop-nav" aria-label="Navigation principale">{nav.map(item => <Link href={item.href} aria-current={item.slug && page.slug === item.slug ? 'page' : undefined}>{item.label}</Link>)}</nav><Link class="header-cta" href={CLUB.trial}><span>Réserver mon essai<small>{CLUB.trialPrice} · TOULOUSE MINIMES</small></span><Arrow diagonal /></Link><Link class="mobile-club-cta" href={CLUB.trial} aria-label={`Réserver mon essai à ${CLUB.trialPrice} — site officiel du club, nouvel onglet`}><span>Mon essai<small>{CLUB.trialPrice} · MINIMES</small></span><Arrow diagonal /></Link><details class="mobile-menu"><summary aria-controls="mobile-navigation">Menu <span aria-hidden="true">+</span></summary><nav id="mobile-navigation" aria-label="Navigation mobile"><Link href="/" aria-current={!page.slug ? 'page' : undefined}>Accueil</Link>{nav.map(item => <Link href={item.href} aria-current={item.slug && page.slug === item.slug ? 'page' : undefined}>{item.label}</Link>)}<Link class="menu-trial" href={CLUB.trial}>Réserver mon essai · {CLUB.trialPrice} <Arrow diagonal /><small>AU CLUB DE TOULOUSE MINIMES</small></Link></nav></details></header>
    <div class="menu-backdrop" aria-hidden="true"></div>
    <main id="contenu"><slot /></main>
    <footer class="site-footer"><div class="footer-top"><p class="eyebrow">TA PROCHAINE SÉANCE COMMENCE ICI.</p><Link href={CLUB.trial} class="footer-invitation">ON SE<br /><em>RETROUVE ?</em><Arrow diagonal /></Link><div class="footer-location"><span class="route-dot"></span><p>TOI, À BLAGNAC.<br />LE CLUB, À TOULOUSE MINIMES.</p><p>{CLUB.address}<br /><Link href="/contact/">Préparer ta venue →</Link></p></div></div><div class="footer-grid"><div><Brand footer /><p>La boxe proche de Blagnac.<br />Ton entraînement aux Minimes.</p></div><nav aria-label="Pratiques en pied de page">{disciplines.map(d => <Link href={`/${d.slug}/`}>{d.name} près de Blagnac</Link>)}</nav><nav aria-label="Informations pratiques"><Link href="/club-boxe-blagnac/">Le club & ta première visite</Link><Link href="/plannings/">Plannings</Link><Link href="/tarifs/">Tarifs</Link><Link href="/contact/">Contact & accès</Link><Link href="/mentions-legales/">Mentions légales</Link><Link href="/confidentialite/">Confidentialité</Link></nav></div><div class="footer-bottom"><span>BOXING CENTER · DEPUIS BLAGNAC</span><Link href={CLUB.url}>Le site de Toulouse Minimes <Arrow diagonal /></Link><div class="theme-switch" role="group" aria-label="Palette de couleurs"><span>COULEURS</span><button type="button" data-theme-choice="minimes" aria-pressed="true">Minimes</button><button type="button" data-theme-choice="blagnac" aria-pressed="false">Blagnac</button></div></div></footer>
    <ClubPrompt slug={page.slug} />
    <script>import '../scripts/site.ts';</script>
  </body>
</html>
