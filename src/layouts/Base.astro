---
import '../styles/global.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource-variable/manrope';
import Arrow from '../components/Arrow.astro';
import { SITE, CLUB, disciplines } from '../data/site.mjs';
const { page, noindex = false } = Astro.props;
const path = page.slug ? `/${page.slug}/` : '/';
const canonical = `${SITE}${path}`;
const social = `${SITE}/social/${page.slug || 'accueil'}.png`;
const schema = [
  { '@type': 'WebSite', '@id': `${SITE}/#website`, url: `${SITE}/`, name: 'Boxing Center — depuis Blagnac', inLanguage: 'fr-FR', about: { '@id': 'https://boxe-toulouse.com/#salle' }, audience: { '@type': 'Audience', geographicArea: { '@type': 'City', name: 'Blagnac' } } },
  { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: page.title, description: page.description, inLanguage: 'fr-FR', isPartOf: { '@id': `${SITE}/#website` }, about: { '@id': 'https://boxe-toulouse.com/#salle' }, primaryImageOfPage: { '@type': 'ImageObject', url: social } },
  ...(page.slug ? [{ '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Boxe près de Blagnac', item: `${SITE}/` }, { '@type': 'ListItem', position: 2, name: page.title.split(' — ')[0], item: canonical }] }] : []),
  ...(page.faqs?.length ? [{ '@type': 'FAQPage', '@id': `${canonical}#faq`, mainEntity: page.faqs.map((q) => ({ '@type': 'Question', name: q.question, acceptedAnswer: { '@type': 'Answer', text: q.answer } })) }] : [])
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title}</title><meta name="description" content={page.description} /><meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} /><link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#6ee3c8" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" /><meta property="og:locale" content="fr_FR" /><meta property="og:site_name" content="Boxing Center — depuis Blagnac" /><meta property="og:title" content={page.title} /><meta property="og:description" content={page.description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={social} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={`${page.title} — Toulouse Minimes, pour les habitants de Blagnac`} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={page.title} /><meta name="twitter:description" content={page.description} /><meta name="twitter:image" content={social} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': schema }).replace(/</g, '\u003c')} />}
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header"><a class="brand" href="/" aria-label="Boxing Center, accueil"><span class="brand-symbol" aria-hidden="true"><i></i><i></i><i></i></span><span>BOXING<br />CENTER<span class="brand-local">DEPUIS BLAGNAC</span></span></a><nav class="desktop-nav" aria-label="Navigation principale"><a href="/#disciplines">Les pratiques</a><a href="/club-boxe-blagnac/">Le club proche de vous</a><a href="/plannings/">Les horaires</a></nav><a class="header-cta" href={CLUB.trial}>Faire le premier pas <Arrow diagonal /></a><details class="mobile-menu"><summary>Menu <span aria-hidden="true">+</span></summary><nav aria-label="Navigation mobile"><a href="/">Accueil</a><a href="/#disciplines">Les pratiques</a><a href="/club-boxe-blagnac/">Le club proche de vous</a><a href="/plannings/">Plannings</a><a href="/tarifs/">Tarifs</a><a href="/contact/">Contact & accès</a><a href={CLUB.trial}>Préparer une séance d’essai ↗</a></nav></details></header>
    <main id="contenu"><slot /></main>
    <footer class="site-footer"><div class="footer-top"><p class="eyebrow">LE PROCHAIN MOUVEMENT VOUS APPARTIENT.</p><a href={CLUB.trial} class="footer-invitation">ON SE<br /><em>RETROUVE ?</em><Arrow diagonal /></a><div class="footer-location"><span class="route-dot"></span><p>VOUS, À BLAGNAC.<br />LE CLUB, À TOULOUSE MINIMES.</p><p>{CLUB.address}<br /><a href={CLUB.contact}>Préparer votre venue ↗</a></p></div></div><div class="footer-grid"><div><a class="footer-brand" href="/">BOXING CENTER</a><p>La boxe proche de Blagnac.<br />Votre entraînement aux Minimes.</p></div><nav aria-label="Pratiques en pied de page">{disciplines.map(d => <a href={`/${d.slug}/`}>{d.name} près de Blagnac</a>)}</nav><nav aria-label="Informations pratiques"><a href="/club-boxe-blagnac/">Le club & votre première visite</a><a href="/plannings/">Plannings</a><a href="/tarifs/">Tarifs</a><a href="/contact/">Contact & accès</a><a href="/confidentialite/">Confidentialité</a></nav></div><div class="footer-bottom"><span>BOXING CENTER · DEPUIS BLAGNAC</span><a href={CLUB.url}>Le site de Toulouse Minimes <Arrow diagonal /></a><span>À VOTRE RYTHME.</span></div></footer>
    <script>import '../scripts/site.ts';</script>
  </body>
</html>
