---
import Link from './Link.astro';
import Arrow from './Arrow.astro';
import { disciplines, CLUB } from '../data/site.mjs';
/**
 * Formulaire natif : POST vers /api/contact/, qui relaie au club via Inlet (le service
 * de formulaires d'Eddy) et redirige vers /merci/. Il fonctionne sans JavaScript.
 * Le script du site pré-remplit le message avec la fiche de départ quand elle existe,
 * et affiche l'erreur quand l'URL porte ?erreur=.
 */
---
<section class="contact-form section-pad" id="formulaire" aria-labelledby="form-title" data-prompt-clear>
  <div class="contact-form-intro"><p class="eyebrow">ÉCRIRE AU CLUB</p><h2 id="form-title">Ta question<br /><em>arrive au club.</em></h2><p>Une vraie personne la lit et te répond avec le cours et le créneau qui correspondent à ce que tu décris. Pour une réponse immédiate, le téléphone reste le plus rapide : <Link href={CLUB.phoneHref}>{CLUB.phone}</Link>.</p></div>
  <form class="form" method="POST" action="/api/contact/" data-contact-form>
    <p class="form-error" role="alert" hidden tabindex="-1" data-form-error data-error-config={`Le formulaire n’est pas encore activé sur ce site. Appelle le club au ${CLUB.phone} : un coach décroche.`} data-error-send={`Ta demande n’a pas pu partir. Réessaie dans un instant, ou appelle le club au ${CLUB.phone}.`}></p>
    <input type="hidden" name="fiche" value="" data-fiche-field />
    <p class="form-honeypot" aria-hidden="true"><label for="_gotcha">Ne pas remplir</label><input type="text" id="_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" /></p>
    <div class="form-grid">
      <label>Ton prénom<input type="text" name="prenom" required autocomplete="given-name" maxlength="80" /></label>
      <label>Ton nom<input type="text" name="nom" autocomplete="family-name" maxlength="80" /></label>
      <label>Ton courriel<input type="email" name="email" required autocomplete="email" inputmode="email" maxlength="160" /></label>
      <label>Ton téléphone<input type="tel" name="telephone" autocomplete="tel" inputmode="tel" maxlength="40" /></label>
      <label>La pratique qui t’attire<select name="pratique" data-pratique><option value="">Je ne sais pas encore</option>{disciplines.map(d => <option value={d.name}>{d.name}</option>)}</select></label>
      <label class="form-wide">Ton message<textarea name="message" rows="6" required maxlength="4000" data-message placeholder="Je pars de Blagnac, je débute, je peux venir le soir…"></textarea></label>
    </div>
    <div class="form-actions"><button type="submit" class="button button-dark">Envoyer au club <Arrow diagonal /></button><p class="field-note">Tes informations servent uniquement à te répondre. <Link href="/confidentialite/">Confidentialité →</Link></p></div>
  </form>
</section>
