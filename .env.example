# Optionnel : valeur fournie par Google Search Console après vérification de propriété.
# Laisser vide tant qu'aucun jeton de vérification n'a été fourni.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Identifiant du formulaire créé dans Inlet pour ce site (relais de /api/contact/).
# Variable serveur : à définir dans Vercel (Settings → Environment Variables), jamais préfixée PUBLIC_.
# Sans elle, le formulaire affiche le téléphone du club au lieu d'envoyer.
INLET_FORM_ID=
